# IPTV Proxy 配置样例（首次安装时复制为 config.toml）
# 键面对齐目标 v0.8.2；未列出的键取默认值。

[server]
bind = "[::]:19899"
log_level = "info"

[auth]
token_enabled = false

[cache]
disk_path = "./cache"

# 字幕机翻（可选）。url 可写根地址、/translate 或 /translate/batch。
# [subtitle.translate]
# enabled = true
# url = "https://translate.ipacel.cc/translate"
# target = "zh-cn"
# source = "auto"
# token = ""

# EPG 翻译（可选）。engine = "mtran" 时使用 mtran_url。
# [epg.translate]
# enabled = true
# engine = "mtran"
# mtran_url = "https://translate.ipacel.cc"
# mtran_token = ""
# target = "zh-cn"
# mtran_batch = 50

[[groups]]
id = "demo"
name = "示例分组"
mode = "proxy"
access = "public"

[[groups.channels]]
id = "c1"
name = "示例频道"
url = "http://example.com/live.m3u8"
